<article class="entry content-bg single-entry post type-page status-publish hentry">
	<div class="entry-content-wrap">
		<div class="entry-content single-content">
			<h1>Академия: Білім және тәжірибе</h1>
			<p class="has-medium-font-size">Қош келдіңіз! Бұл – менің көпжылдық зерттеулерім мен оқыту тәжірибемнің нәтижесінде жинақталған білім орталығы. «Академияның» мақсаты – тіл білімі мен әдебиет әлеміндегі күрделі идеяларды қарапайым әрі қолжетімді ету. Мұнда студенттер, оқытушылар және тілге қызығатын кез келген жан өз ізденісіне қажетті ресурстарды таба алады.</p>
		</div>
	</div>
</article>

<div class="blog-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(300px, 1fr));gap:2rem;margin-top:2rem;">
{% for item in collections.materials %}
	<article class="entry content-bg loop-entry card-effect" style="border-radius:8px;overflow:hidden;">
		{% if item.data.image %}
		<a class="post-thumbnail kadence-thumbnail-ratio-2-3" href="{{ item.url }}">
			<div class="post-thumbnail-inner"><img src="{{ item.data.image }}" alt="{{ item.data.title }}"></div>
		</a>
		{% endif %}
		<div class="entry-content-wrap" style="padding:1.5rem;">
			<header class="entry-header post-title">
				<h2 class="entry-title"><a href="{{ item.url }}" rel="bookmark">{{ item.data.title }}</a></h2>
			</header>
			<div class="entry-summary">
				<p>{{ item.data.description }}</p>
			</div>
			<p><a href="{{ item.url }}">Толығырақ</a></p>
		</div>
	</article>
{% endfor %}
</div>
